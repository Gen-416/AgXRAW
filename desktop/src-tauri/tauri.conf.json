{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgXRAW",
  "version": "0.2.0",
  "identifier": "io.gen416.agxraw",
  "build": {
    "beforeDevCommand": "npm run dev:ui",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "AgXRAW", "width": 1380, "height": 940, "minWidth": 850, "minHeight": 650 }],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "macOS": { "minimumSystemVersion": "14.0" } }
}
